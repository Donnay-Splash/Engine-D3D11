{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure macOS engine",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/macos",
                "-G",
                "Unix Makefiles"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build shader compiler",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/macos",
                "--target",
                "shader-compiler"
            ],
            "dependsOn": "Configure macOS engine",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build macOS shaders",
            "type": "shell",
            "command": "${workspaceFolder}/build/macos/tools/ShaderCompiler/shader-compiler",
            "args": [
                "--config",
                "${workspaceFolder}/tools/ShaderCompiler/shaders.cfg"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build shader compiler",
            "problemMatcher": []
        },
        {
            "label": "Build macOS app",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/macos",
                "--target",
                "engine-macos"
            ],
            "dependsOn": [
                "Configure macOS engine",
                "Build macOS shaders"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}
